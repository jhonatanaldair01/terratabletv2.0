# URL de conexión de Supabase PostgreSQL (Transaction Pooler recomendado).
DATABASE_URL=postgresql://usuario:contrasena@host:6543/postgres
DATABASE_SSL=true

# URL pública del proyecto frontend ya desplegado.
FRONTEND_URL=https://tu-frontend.vercel.app

# Supabase: URL y clave publicable (misma que usa el frontend para Storage).
# Se usan para validar el login del kiosco contra Supabase Auth.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave de servicio (Settings > API > service_role). OPCIONAL pero recomendada:
# permite crear/editar usuarios del kiosco sin enviar correos ni topar el límite
# de envíos de Supabase, y fijar contraseñas (npm run usuario -- --cambiar-password).
# NUNCA la expongas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Credenciales privadas del panel administrador.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_TOKEN_SECRET=genera-una-clave-larga-aleatoria

# Sesión de usuarios web (kiosco). Si se omite, se reutiliza ADMIN_TOKEN_SECRET.
WEB_TOKEN_SECRET=genera-otra-clave-larga-aleatoria

# Usuario mayorista en Supabase Auth + tabla public.users (se crea al iniciar el
# backend si no existe; no sobreescribe la contraseña si ya existe).
MAYORISTA_EMAIL=mayorista@gmail.com
MAYORISTA_PASSWORD=123456
MAYORISTA_NOMBRE=Mayorista TERRA
